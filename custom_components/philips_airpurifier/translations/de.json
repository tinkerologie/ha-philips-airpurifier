    },
    "filter_replacement_warning": {
      "title": "Filterwechsel erforderlich",
      "description": "Mindestens ein Filter Ihres Luftreinigers muss gewartet werden. Prüfen Sie anhand der Filterstatus-Sensoren, ob ein Filter gewechselt oder gereinigt werden muss. Starten Sie die Reparatur, um diese Warnung zu bestätigen."
    },
    "configuration_migration": {
      "title": "Migration der Konfiguration erforderlich",
      "description": "Die Konfiguration der Integration muss aktualisiert werden, um neue Funktionen zu unterstützen. Die Migration aktualisiert Ihre Konfiguration automatisch, ohne dass Einstellungen verloren gehen."
    },
    "duplicate_entities": {
      "title": "Doppelte Entitäten erkannt",
