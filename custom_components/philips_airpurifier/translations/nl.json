    },
    "configuration_migration": {
      "title": "Migratie van configuratie vereist",
      "description": "De configuratie van de integratie moet worden bijgewerkt om nieuwe functies te ondersteunen. Deze migratie werkt je configuratie automatisch bij zonder dat er instellingen verloren gaan."
    },
    "duplicate_entities": {
      "title": "Dubbele entiteiten gedetecteerd",
      "description": "Er zijn dubbele entiteiten gedetecteerd. Dit gebeurt meestal wanneer de unieke ID’s van entiteiten met elkaar conflicteren. Start de reparatie om dubbele entiteiten automatisch te verwijderen."
