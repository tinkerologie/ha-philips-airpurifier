#!/bin/bash

# script/ha-version-sync: Validate HA release-train consistency across all version sources
#
# Checks that hacs.json and pyproject.toml declare the same minimum and the
# locked Home Assistant development/test version meets that minimum.
#
# Exits non-zero when a mismatch is detected so that pre-commit and CI jobs can
# surface the inconsistency before it reaches the main branch.
#
# Usage:
#   ./script/ha-version-sync
#
# Called by script/test-minimum locally and in the minimum-version CI job.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

python3 <<'PY'
import json
from pathlib import Path
import re
import tomllib


def version(value: str) -> tuple[int, int, int]:
    match = re.fullmatch(r"(\d{4})\.(\d+)\.(\d+)", value)
    if not match:
        raise SystemExit(f"Expected stable Home Assistant version, got {value!r}")
    return tuple(map(int, match.groups()))


hacs_min = json.loads(Path("hacs.json").read_text())["homeassistant"]
project = tomllib.loads(Path("pyproject.toml").read_text())
requirement = next(r for r in project["project"]["optional-dependencies"]["dev"] if r.startswith("homeassistant>="))
project_min = requirement.removeprefix("homeassistant>=")
if version(hacs_min) != version(project_min):
    raise SystemExit(f"HA minimum mismatch: HACS={hacs_min}, pyproject={project_min}")
minimum_requirements = Path("requirements_test_min.txt").read_text()
minimum = re.search(r"^homeassistant==([^\s#]+)", minimum_requirements, re.MULTILINE)
helper = re.search(r"^pytest-homeassistant-custom-component==([^\s#]+)", minimum_requirements, re.MULTILINE)
if not minimum or not helper:
    raise SystemExit("Minimum-version requirements must pin Home Assistant and its pytest helper")
if version(minimum.group(1)) != version(hacs_min):
    raise SystemExit("Minimum test version must equal the HACS support floor")
lock = tomllib.loads(Path("uv.lock").read_text())
locked = next(p["version"] for p in lock["package"] if p["name"] == "homeassistant")
if version(locked) < version(hacs_min):
    raise SystemExit(f"Locked HA {locked} is below supported minimum {hacs_min}")
print(f"HA version sync OK: minimum {hacs_min}, locked development/test version {locked}")
PY
