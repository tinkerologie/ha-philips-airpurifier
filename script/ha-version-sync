#!/bin/bash

# script/ha-version-sync: Validate HA release-train consistency across all version sources
#
# Checks the HACS support floor and the separate, matched Home Assistant and
# pytest plugin versions in the development lock.
#
# Exits non-zero when a mismatch is detected so that pre-commit and CI jobs can
# surface the inconsistency before it reaches the main branch.
#
# Usage:
#   ./script/ha-version-sync
#
# Called by script/test-minimum locally and in the minimum-version CI job.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

python3 <<'PY'
import json
from pathlib import Path
import re
import tomllib


def version(value: str) -> tuple[int, int, int]:
    match = re.fullmatch(r"(\d{4})\.(\d+)\.(\d+)", value)
    if not match:
        raise SystemExit(f"Expected stable Home Assistant version, got {value!r}")
    return tuple(map(int, match.groups()))


def pinned_version(requirements: list[str], package: str) -> str:
    prefix = f"{package}=="
    pins = [requirement.removeprefix(prefix) for requirement in requirements if requirement.startswith(prefix)]
    if len(pins) != 1:
        raise SystemExit(f"Expected one exact pin for {package}")
    return pins[0]


def requirement_names(requirements: list[str]) -> set[str]:
    return {re.split(r"[<>=!~;\[ @]", requirement, maxsplit=1)[0].lower().replace("_", "-") for requirement in requirements}


hacs_min = json.loads(Path("hacs.json").read_text())["homeassistant"]
minimum = [
    line.split("#", 1)[0].strip()
    for line in Path("requirements_test_min.txt").read_text().splitlines()
    if line.split("#", 1)[0].strip()
]
official = "pytest-homeassistant"
legacy = "pytest-homeassistant-custom-component"
if official in requirement_names(minimum):
    raise SystemExit("Minimum test requirements must use only the legacy pytest plugin")
pinned_version(minimum, legacy)
if version(pinned_version(minimum, "homeassistant")) != version(hacs_min):
    raise SystemExit("Minimum test version must equal the HACS support floor")

project = tomllib.loads(Path("pyproject.toml").read_text())
dev = project["project"]["optional-dependencies"]["dev"]
if legacy in requirement_names(dev):
    raise SystemExit("Development dependencies must use only the official pytest plugin")
target = pinned_version(dev, "homeassistant")
if version(target) < version(hacs_min):
    raise SystemExit(f"Development HA {target} is below supported minimum {hacs_min}")
if pinned_version(dev, official) != target:
    raise SystemExit(f"The development pytest plugin pin must match HA {target}")

lock = tomllib.loads(Path("uv.lock").read_text())
packages = {package["name"]: package["version"] for package in lock["package"]}
if legacy in packages:
    raise SystemExit("The legacy pytest plugin must be absent from the development lock")
for package in ("homeassistant", official):
    if packages.get(package) != target:
        raise SystemExit(f"Locked {package} must match development HA {target}")
print(f"HA version sync OK: minimum {hacs_min}, development HA and pytest plugin {target}")
PY
